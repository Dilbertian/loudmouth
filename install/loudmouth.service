[Unit]
Description=Loudmouth — always-on audio playback service
After=network.target sound.target

[Service]
Type=simple
User=loudmouth
WorkingDirectory=/opt/loudmouth
ExecStart=/opt/loudmouth/venv/bin/python /opt/loudmouth/server.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Fleet install: reachable on the LAN, standard port 8765 (fallback 8766).
# Remove LOUDMOUTH_HOST to lock down to loopback-only.
Environment=LOUDMOUTH_HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
